{
  "name": "spun",
  "version": "0.3.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "dev:preview": "node scripts/ensure-deps.mjs && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:dev": "concurrently -k \"npm:dev\" \"wait-on tcp:127.0.0.1:3000 && electron .\"",
    "electron:rebuild": "electron-rebuild -f -w better-sqlite3",
    "electron:build": "mkdir -p dist-recognizer dist-ffmpeg && npm run electron:rebuild && npm run build && electron-builder"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "electron-updater": "^6.8.9",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "overrides": {
    "postcss": ">=8.5.10"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/ui": "^4.1.10",
    "concurrently": "^10.0.4",
    "electron": "^39.8.5",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.6",
    "wait-on": "^9.1.0"
  }
}
