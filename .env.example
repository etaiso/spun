# Optional: enable the Spotify playlist-export integration (desktop app only).
#
# Create an app at https://developer.spotify.com/dashboard, enable the Web API,
# and register the redirect URI exactly as below, then copy the Client ID here.
# PKCE is used, so NO client secret is needed.
#
# Caveats (Spotify, since Feb 2026): the Web API requires the app owner to have
# Spotify Premium, and a Development-Mode app is limited to 5 authorized users.
#
# Redirect URI to register in the dashboard: http://127.0.0.1:8888/callback
#
# Leave unset to disable the integration entirely (the feature stays hidden).
SPOTIFY_CLIENT_ID=
